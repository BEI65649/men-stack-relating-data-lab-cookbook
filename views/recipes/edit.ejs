<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Recipe</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('../partials/_navbar.ejs') %>
  <div class="container">
    <header>
      <h1>Edit Recipe</h1>
    </header>
    <main>
      <form action="/recipes/<%= recipe._id %>?_method=PUT" method="POST">
        <div class="form-group">
          <label for="name">Name:</label>
          <input type="text" name="name" id="name" value="<%= recipe.name %>" required />
        </div>
        <div class="form-group">
          <label for="instructions">Instructions:</label>
          <textarea name="instructions" id="instructions" required><%= recipe.instructions %></textarea>
        </div>
        <div class="form-group">
          <label>Ingredients:</label>
          <select multiple name="ingredients" required>
            <% ingredients.forEach(ingredient => { %>
              <option value="<%= ingredient._id %>" <%= recipe.ingredients.some(i => i._id.toString() === ingredient._id.toString()) ? 'selected' : '' %>>
                <%= ingredient.name %>
              </option>
            <% }) %>
          </select>
        </div>
        <button type="submit" class="btn">Update Recipe</button>
      </form>
      <div class="links">
        <a href="/recipes" class="btn">Back to Recipes</a>
        <a href="/" class="btn">Back to Home</a>
      </div>
    </main>
  </div>
  <footer>
    <p>&copy; 2025 Our Home Cookbook</p>
  </footer>
</body>
</html>