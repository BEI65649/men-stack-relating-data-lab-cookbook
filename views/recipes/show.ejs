<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= recipe.name %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('../partials/_navbar.ejs') %>
  <div class="container">
    <header>
      <h1><%= recipe.name %></h1>
    </header>
    <main>
      <div class="section">
        <h2>Instructions</h2>
        <p><%= recipe.instructions %></p>
      </div>
      <div class="section">
        <h2>Ingredients</h2>
        <% if (recipe.ingredients && recipe.ingredients.length > 0) { %>
          <ul>
            <% recipe.ingredients.forEach(ingredient => { %>
              <li><%= ingredient.name %> - <%= ingredient.category %></li>
            <% }) %>
          </ul>
        <% } else { %>
          <p>No ingredients added to this recipe.</p>
        <% } %>
      </div>
      <div class="actions">
        <form action="/recipes/<%= recipe._id %>?_method=DELETE" method="POST">
          <button type="submit" class="btn btn-danger">Delete Recipe</button>
        </form>
        <a href="/recipes/<%= recipe._id %>/edit" class="btn">Edit Recipe</a>
        <a href="/recipes" class="btn">Back to Recipes</a>
      </div>
    </main>
  </div>
  <footer>
    <p>&copy; 2025 Our Home Cookbook</p>
  </footer>
</body>
</html>